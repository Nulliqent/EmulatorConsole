{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src/server", "src/shared"],
  "exclude": ["src/server/**/*.test.ts", "src/server/**/*.testkit.ts", "src/server/model-index/build"]
}
